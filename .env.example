# Example environment file for docker-compose.yml / docker-compose-simple.yml.
#
# WARNING: The default values shown below (rustfsadmin/rustfsadmin, admin, "*" CORS) are
# INSECURE and intended for local development only. Copy this file to `.env`, set real
# values, and never commit the resulting `.env` file (it is already gitignored).
#
#   cp .env.example .env

# --- RustFS credentials ---
# Access/secret key used by the RustFS S3 API and console.
# Default if unset: rustfsadmin / rustfsadmin (INSECURE, local dev only)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# --- CORS ---
# Comma-separated list of allowed origins for the S3 API and console.
# Default if unset: "*" (allows any origin - INSECURE, local dev only)
RUSTFS_CORS_ALLOWED_ORIGINS=*
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*

# --- Grafana (observability profile) ---
# Admin password for the Grafana UI.
# Default if unset: admin (INSECURE, local dev only)
GRAFANA_ADMIN_PASSWORD=admin
