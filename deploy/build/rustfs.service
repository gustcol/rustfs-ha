[Unit]
Description=RustFS Object Storage Server
Documentation=https://rustfs.com/docs/
After=network-online.target
Wants=network-online.target
# Order after the mount(s) backing the data path so the service never starts
# against an empty mountpoint directory (critical on ZFS/LVM hosts where the
# dataset/volume mounts after boot). Update to match RUSTFS_VOLUMES below.
RequiresMountsFor=/srv/rustfs
# If you're using a database, you'll need to add the corresponding dependencies
# After=postgresql.service
# Requires=postgresql.service

[Service]
Type=notify
NotifyAccess=main
User=rustfs
Group=rustfs

# working directory
WorkingDirectory=/opt/rustfs

# Environment variables and volumes are read from this file, see
# `../config/rustfs.env` for an example. Volumes are POSITIONAL arguments to
# rustfs, not a --volumes flag. RUSTFS_VOLUMES must be unbraced
# ($RUSTFS_VOLUMES, not ${RUSTFS_VOLUMES}) so systemd's environment expansion
# splits a space-separated list into one positional argument per volume.
# RUSTFS_OPTS carries the remaining flags (--address, etc.), as in the
# shipped `../config/rustfs.env` example.
EnvironmentFile=/etc/default/rustfs
ExecStart=/usr/local/bin/rustfs $RUSTFS_VOLUMES $RUSTFS_OPTS

# Logs go to the journal (see `journalctl -u rustfs`). Do not redirect
# stdout/stderr to files under a path that isn't created by this unit -
# systemd will not create it for you, and the service will fail to log.

# resource constraints
LimitNOFILE=1048576
LimitNPROC=32768
TasksMax=infinity

# restart the policy
Restart=always
RestartSec=10s

# graceful exit configuration
TimeoutStartSec=30s
TimeoutStopSec=30s

# security settings
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
# Must match the volumes passed to rustfs above (RUSTFS_VOLUMES in
# /etc/default/rustfs), or writes to volumes outside this path will be
# blocked by ProtectSystem=full.
ReadWritePaths=/srv/rustfs

[Install]
WantedBy=multi-user.target
